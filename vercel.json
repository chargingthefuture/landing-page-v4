{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/feed/:path*",
      "has": [
        {
          "type": "host",
          "value": "chargingthefuture.com"
        }
      ],
      "destination": "https://chargingthefuture.github.io/chargingthefuture/feed",
      "permanent": false
    },
    {
      "source": "/feed/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.chargingthefuture.com"
        }
      ],
      "destination": "https://chargingthefuture.github.io/chargingthefuture/feed",
      "permanent": false
    },
    {
      "source": "/feed",
      "destination": "https://chargingthefuture.github.io/chargingthefuture/feed",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|assets/|fonts/|index\\.html$|app\\.html$)[^.]+)",
      "destination": "/app.html"
    }
  ]
}
